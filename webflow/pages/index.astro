---
const cacheVersion = "swcr-design-2";
const appBasePath = "/web-video-compressor";
const assetPath = (filename) => `${appBasePath}/${filename}?v=${cacheVersion}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Web Video Compressor</title>
    <link rel="icon" href="data:," />
    <link rel="stylesheet" href={assetPath("workspace.css")} />
  </head>
  <body class="web-workspace">
    <main class="app-shell" aria-labelledby="compressor-title">
      <div id="toolStatus" class="tool-alert" role="alert" hidden></div>
      <div class="workspace-grid">
        <div class="source-column">
          <header class="intro">
            <h1 id="compressor-title">Web video compressor</h1>
            <p>Prepare videos for custom builds into industry standard responsive web sizes, using web-appropriate compression for efficient file sizes. Outputs include MP4 and WEBM video files, plus an automatically captured poster image.</p>
          </header>
          <section aria-labelledby="source-heading">
            <h2 id="source-heading">Upload video</h2>
            <div id="dropZone" class="source-drop" aria-label="Drop .mov or .mp4 video files">
              <p class="source-drop__heading">Drag &amp; drop to upload</p>
              <button id="selectFileButton" type="button" class="file-picker">Choose file</button>
              <div id="sourceSelection" class="source-selection" hidden></div>
              <p id="sourceGuidance" class="source-guidance" hidden></p>
              <span id="selectionText" class="sr-only">No source selected</span>
              <span id="outputText" class="sr-only"></span>
            </div>
            <div class="button-row source-actions">
              <button id="resetButton" type="button" class="text-button" disabled>Reset</button>
              <button id="downloadZipButton" type="button" hidden disabled>Download ZIP</button>
            </div>
            <p class="privacy-note">MOV or MP4. Videos stay on your device. Keep this tab open while compressing.</p>
          </section>
        </div>
        <div class="output-column">
          <section aria-labelledby="quality-heading">
            <h2 id="quality-heading">Video quality</h2>
            <div class="compression-card">
              <div class="quality-ticks" aria-hidden="true"><span>low</span><span class="quality-tick--active">medium</span><span>high</span></div>
              <input id="qualitySlider" type="range" min="0" max="2" step="1" value="1" aria-label="Video quality" aria-describedby="qualityDescription" />
              <p id="qualityDescription" class="quality-description">Default, for balanced quality and size</p>
              <span id="qualityLabel" class="sr-only">Medium</span>
            </div>
          </section>
          <section aria-labelledby="output-heading">
            <h2 id="output-heading">Compressing video</h2>
            <p id="summaryText" class="muted output-summary" role="status" aria-live="polite">No videos queued.</p>
            <div id="queueList" class="queue-list"><p class="muted">Choose a video to see its outputs.</p></div>
            <div id="runActions" class="button-row output-actions">
              <button id="outputActionButton" type="button" disabled>Start compression</button>
            </div>
          </section>
        </div>
      </div>
      <span id="sourceSubtitle" hidden></span><span id="compressionSubtitle" hidden></span><span id="outputSubtitle" hidden></span>
    </main>
    <script src={assetPath("export-plan.js")}></script>
    <script src={assetPath("zip-download.js")}></script>
    <script src={assetPath("tauri-adapter.js")}></script>
    <script src={assetPath("browser-adapter.js")}></script>
    <script src={assetPath("renderer.js")}></script>
  </body>
</html>
